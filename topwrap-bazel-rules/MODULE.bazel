module(
    name = "rules_topwrap",
    version = "0.0.1",
)

bazel_dep(name = "rules_python", version = "2.4.2")
bazel_dep(name = "rules_pkg", version = "1.2.0")

# rules_hdl isn't on the Bazel Central Registry; its main branch has its
# own MODULE.bazel, so pull it in via git_override.
bazel_dep(name = "rules_hdl")
git_override(
    module_name = "rules_hdl",
    commit = "3998e10bc9506f9f3511427cf421e1fc4a142b0e",
    patch_strip = 1,
    patches = ["//patches:rules_hdl_python313.patch"],
    remote = "https://github.com/hdl/bazel_rules_hdl.git",
)

# Pinned to Bazel 8.7.0 (see .bazelversion): rules_cc relies on legacy
# providers Bazel 9 removed.
single_version_override(
    module_name = "rules_cc",
    version = "0.2.17",
)

# rules_hdl uses bazel_deps on these without a registry version, so they must 
# be resolved via override even though this module doesn't build their targets.
git_override(
    module_name = "rules_7zip",
    commit = "03a10b5796eac0aed122cf52064ed15785610857",
    remote = "https://github.com/zaucy/rules_7zip.git",
)

git_override(
    module_name = "openroad",
    commit = "51c9638fb0b005e5d60d7216970110543621125c",
    init_submodules = True,
    remote = "https://github.com/The-OpenROAD-Project/OpenROAD.git",
)

git_override(
    module_name = "qt-bazel",
    commit = "90cfbab79df93960c5493f8a75df6199fb80fe26",
    remote = "https://github.com/The-OpenROAD-Project/qt_bazel_prebuilts",
)

# Must match rules_hdl's own pip vendor hub python_version.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pip")

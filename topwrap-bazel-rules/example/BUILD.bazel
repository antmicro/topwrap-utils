load("@rules_hdl//verilog:defs.bzl", "verilog_library")
load("@rules_topwrap//:defs.bzl", "topwrap_design", "topwrap_design_gui", "topwrap_library", "topwrap_parse_sources")

# 1. Parse an existing IP verilog_library into topwrap core descriptions.
topwrap_parse_sources(
    name = "my_parsed_ip",
    deps = ["//parsed_ip:parsed_ip_lib"],
)

# 2. Assemble a library from a manualy written and a parsed core
topwrap_library(
    name = "my_library",
    cores = [
        ":my_parsed_ip",
        "//manual_ip:manual_ip",
    ],
)

# 2b. Infer a custom interface.
topwrap_library(
    name = "my_interfaces",
    interfaces = ["//custom_iface:my_stream.yaml"],
)

topwrap_parse_sources(
    name = "my_stream_ip",
    modules = ["stream_ip"],
    emit_interfaces = False,
    libraries = [":my_interfaces"],
    deps = ["//custom_iface:stream_ip_lib"],
)

topwrap_library(
    name = "my_stream_library",
    cores = [":my_stream_ip"],
)

# 3. Generate the top-level wrapper
topwrap_design(
    name = "my_design",
    design = "design.yaml",
    deps = [":my_library"],
)

# 4. Open the design in the GUI.
topwrap_design_gui(
    name = "my_design_gui",
    design = "design.yaml",
    deps = [":my_library"],
)

# 5. Topwrap library packaging

load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

pkg_tar(
    name = "my_library_pkg",
    srcs = [":my_library"],
)

# 6. Synthesis + place-and-route (an example consumer)

load("@rules_hdl//place_and_route:build_defs.bzl", "place_and_route")
load("@rules_hdl//synthesis:defs.bzl", "sdc_library", "synthesize_rtl")

synthesize_rtl(
    name = "my_design_synth",
    tags = ["manual"],
    top_module = "top",
    deps = [":my_design"],
)

sdc_library(
    name = "my_design_sdc",
    srcs = ["my_design.sdc"],
)

place_and_route(
    name = "my_design_pnr",
    tags = ["manual"],
    clock_period = "10",
    core_padding_microns = 20,
    die_height_microns = 200,
    die_width_microns = 200,
    placement_density = "0.7",
    sdc = ":my_design_sdc",
    synthesized_rtl = ":my_design_synth",
)
